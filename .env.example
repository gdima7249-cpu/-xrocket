# Режим: paper (виртуально, без ключей) | demo (демо биржи, напр. Bybit Demo) | testnet | live
MODE=paper
EXCHANGE=xrocket   # xrocket (только paper) | binance | bybit | okx ...
# Для xRocket: в API_KEY вставьте Bearer-токен (или переменная XROCKET_TOKEN), API_SECRET не нужен.
# На testnet xRocket пример пары: SYMBOL=TON/USDT
API_KEY=
API_SECRET=
# Ключи создавайте БЕЗ права вывода средств!

# Комиссия и проскальзывание для бэктеста/расчётов (xRocket по тесту: комиссия ~0.3% за сторону,
# проскальзывание ~0.25%). Для Bybit/Binance спот обычно FEE=0.001
#FEE=0.003
#SLIPPAGE=0.0025

# Виртуальный бот «вверх/вниз» (binary_bot.py): срок ставки, выплата, виртуальный баланс, доля ставки
#BINARY_SOURCE=xrocket    # источник цен: xrocket | binance (публичные цены, ключи не нужны; самые ликвидные пары к USDT)
#BINARY_BINANCE_TOP=30    # сколько пар брать с Binance
#BINARY_EXPIRY_SEC=60     # срок ставки в секундах (30, 60, 300...); либо BINARY_EXPIRY_MIN=5
#BINARY_SAMPLE_SEC=10     # как часто опрашивать цены (по умолчанию от срока)
#BINARY_PAYOUT=0.85
#BINARY_START=1000      # виртуальный баланс каждого предсказателя
#BINARY_COMPOUND=1       # 1: ставка = % текущего баланса (как на реальном счёте), 0: фиксированная
#BINARY_STATE=binary_state.json  # файл состояния (чтобы запускать несколько копий отдельно)
#BINARY_STAKE_PCT=0.01

# Виртуальная торговля на нескольких биржах по реальным данным (multi_paper.py; ключи не нужны)
#MULTI_EXCHANGES=binance,okx,bybit,kucoin,mexc,kraken,coinbase,xrocket
#MULTI_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,BNB/USDT,DOGE/USDT,ADA/USDT,LINK/USDT
#MULTI_START=1000
#MULTI_POSITION_PCT=0.1
#MULTI_MAX_POSITIONS=8

# Радар: какие пары смотреть (по умолчанию ВСЕ). Ограничить: RADAR_QUOTES=USDT  или  USDT,TON; максимум пар: RADAR_MAX_PAIRS
#RADAR_QUOTES=ALL
#RADAR_MAX_PAIRS=300

# Радар (radar.py --execute): позиций одновременно и доля капитала на позицию
#RADAR_MAX_POSITIONS=10
#RADAR_POSITION_PCT=0.05

# Сканер просадок (scanner_bot.py): покупает резкое падение на любой паре к USDT, продаёт на отскоке
#SCAN_DROP=0.06          # падение от максимума за SCAN_LOOKBACK часов (6%)
#SCAN_LOOKBACK=24
#SCAN_CONFIRM=1          # 1 = покупать только после зелёной свечи
#SCAN_TAKE=0.05
#SCAN_STOP=0.05
#SCAN_MAX_HOLD_H=48
#SCAN_MAX_POSITIONS=5
#SCAN_POSITION_PCT=0.15  # доля капитала на одну позицию

# Стратегия (спот): ema_rsi | donchian (пробой канала; параметры DONCHIAN_IN/DONCHIAN_OUT)
STRATEGY=ema_rsi
#DONCHIAN_IN=40
#DONCHIAN_OUT=20

# Рынок: spot (только покупки) | futures (long и short, линейные USDT-контракты)
MARKET=spot
# Плечо для futures (1..5). Для futures пара пишется так: BTC/USDT:USDT
LEVERAGE=2

# Стартовый виртуальный баланс в USDT (для paper). 50 руб = 50 / курс USDT
PAPER_BALANCE=1000
# Общий стоп: бот остановится, когда капитал упадёт на этот процент от стартового
# (0.20 = при 1000 -> остановка на 800)
MAX_TOTAL_LOSS_PCT=0.20
# Или абсолютный порог в USDT (необязательно, важнее процента):
# STOP_EQUITY=10
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Необязательно: уведомления в Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Бот трендовых шортов на ТЕСТОВОМ фьючерсном счёте Binance (ls_bot.py). Ключи ТОЛЬКО тестовой сети/демо, никому не присылайте.
#LS_ENV=testnet            # testnet (testnet.binancefuture.com) | demo (demo.binance.com)
#LS_API_KEY=
#LS_API_SECRET=
#LS_POS_PCT=0.05           # доля капитала на позицию
#LS_MAX_POS=10
#LS_MAX_LOSS=0.15          # стоп-кран: потеря 15% капитала -> закрыть всё и остановиться
#LS_STRATS=donchian_ls,ema_ls

# Бот для ДЕМО-счёта Deriv (deriv_demo_bot.py). Токен демо-счёта (права Read и Trade), никому не присылайте.
#DERIV_TOKEN=
#DERIV_APP_ID=1089

# --- rebound_bot.py (Bybit, спот) ---
#BYBIT_ENV=demo             # demo (виртуальные деньги) | real (только с флагом --i-understand-real-money)
#BYBIT_API_KEY=             # ключ с правом ТОЛЬКО «Спот — торговля», без вывода; лучше привязать к IP сервера
#BYBIT_API_SECRET=

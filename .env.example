# Режим: paper (виртуально, без ключей) | demo (демо биржи, напр. Bybit Demo) | testnet | live
MODE=paper
EXCHANGE=xrocket   # xrocket (только paper) | binance | bybit | okx ...
# Для xRocket: в API_KEY вставьте Bearer-токен (или переменная XROCKET_TOKEN), API_SECRET не нужен.
# На testnet xRocket пример пары: SYMBOL=TON/USDT
API_KEY=
API_SECRET=
# Ключи создавайте БЕЗ права вывода средств!

# Комиссия и проскальзывание для бэктеста/расчётов (xRocket по тесту: комиссия ~0.3% за сторону,
# проскальзывание ~0.25%). Для Bybit/Binance спот обычно FEE=0.001
#FEE=0.003
#SLIPPAGE=0.0025

# Сканер просадок (scanner_bot.py): покупает резкое падение на любой паре к USDT, продаёт на отскоке
#SCAN_DROP=0.06          # падение от максимума за SCAN_LOOKBACK часов (6%)
#SCAN_LOOKBACK=24
#SCAN_CONFIRM=1          # 1 = покупать только после зелёной свечи
#SCAN_TAKE=0.05
#SCAN_STOP=0.05
#SCAN_MAX_HOLD_H=48
#SCAN_MAX_POSITIONS=5
#SCAN_POSITION_PCT=0.15  # доля капитала на одну позицию

# Стратегия (спот): ema_rsi | donchian (пробой канала; параметры DONCHIAN_IN/DONCHIAN_OUT)
STRATEGY=ema_rsi
#DONCHIAN_IN=40
#DONCHIAN_OUT=20

# Рынок: spot (только покупки) | futures (long и short, линейные USDT-контракты)
MARKET=spot
# Плечо для futures (1..5). Для futures пара пишется так: BTC/USDT:USDT
LEVERAGE=2

# Стартовый виртуальный баланс в USDT (для paper). 50 руб = 50 / курс USDT
PAPER_BALANCE=1000
# Общий стоп: бот остановится, когда капитал упадёт на этот процент от стартового
# (0.20 = при 1000 -> остановка на 800)
MAX_TOTAL_LOSS_PCT=0.20
# Или абсолютный порог в USDT (необязательно, важнее процента):
# STOP_EQUITY=10
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Необязательно: уведомления в Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

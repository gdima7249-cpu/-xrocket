# Режим: paper (виртуально, без ключей) | demo (демо биржи, напр. Bybit Demo) | testnet | live
MODE=paper
EXCHANGE=xrocket   # xrocket (только paper) | binance | bybit | okx ...
# Для xRocket: в API_KEY вставьте Bearer-токен (или переменная XROCKET_TOKEN), API_SECRET не нужен.
# На testnet xRocket пример пары: SYMBOL=TON/USDT
API_KEY=
API_SECRET=
# Ключи создавайте БЕЗ права вывода средств!

# Рынок: spot (только покупки) | futures (long и short, линейные USDT-контракты)
MARKET=spot
# Плечо для futures (1..5). Для futures пара пишется так: BTC/USDT:USDT
LEVERAGE=2

# Стартовый виртуальный баланс в USDT (для paper). 50 руб = 50 / курс USDT
PAPER_BALANCE=1000
# Общий стоп: бот остановится, когда капитал упадёт на этот процент от стартового
# (0.20 = при 1000 -> остановка на 800)
MAX_TOTAL_LOSS_PCT=0.20
# Или абсолютный порог в USDT (необязательно, важнее процента):
# STOP_EQUITY=10
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Необязательно: уведомления в Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
